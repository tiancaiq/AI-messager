# Loopback Fastify health endpoint.
API_HOST=127.0.0.1
API_PORT=3000

# Phase 2 development only. Copy this file to ignored .env.local and replace
# the placeholder. Never commit a real provider key.
OPENAI_API_KEY=replace-with-your-project-key
# Optional model override; the default is gpt-5.6-luna.
OPENAI_VISION_MODEL=gpt-5.6-luna
