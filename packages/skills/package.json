{
  "name": "@ai-message-coach/skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm registry:check && node ../../scripts/clean-package.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.authoring.json",
    "registry:generate": "node --conditions=development --import tsx authoring/cli.ts --write",
    "registry:check": "node --conditions=development --import tsx authoring/cli.ts --check"
  },
  "dependencies": {
    "@ai-message-coach/contracts": "workspace:*"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  }
}
