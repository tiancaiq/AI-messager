{
  "name": "ai-message-coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.15.1 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/*' --if-present build",
    "dev": "pnpm build:packages && pnpm --parallel --filter './apps/*' dev",
    "dev:api": "pnpm build:packages && pnpm --filter @ai-message-coach/api dev",
    "dev:desktop": "pnpm build:packages && pnpm --filter @ai-message-coach/desktop dev",
    "eval:phase2": "pnpm build:packages && node scripts/evaluate-phase-2.mjs",
    "eval:phase3": "pnpm build:packages && node scripts/evaluate-phase-3.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "~10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "~3.9.6",
    "tsx": "4.23.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
