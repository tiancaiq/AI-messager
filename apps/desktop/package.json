{
  "name": "@ai-message-coach/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main/index.cjs",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:preload && vite build",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-message-coach/contracts": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "electron": "^43.2.0"
  }
}
